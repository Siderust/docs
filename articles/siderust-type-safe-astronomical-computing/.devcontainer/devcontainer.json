{
  "name": "Siderust LaTeX article",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "RUST_VERSION": "1.93.1",
      "TEXLIVE_IMAGE": "texlive/texlive:TL2025-historic"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "remoteUser": "texlive",
  "containerUser": "texlive",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "james-yu.latex-workshop",
        "tamasfe.even-better-toml",
        "rust-lang.rust-analyzer",
        "ms-python.python"
      ],
      "settings": {
        "[latex]": {
          "editor.defaultFormatter": "James-Yu.latex-workshop",
          "editor.formatOnSave": true
        },
        "latex-workshop.latex.rootFile": "%WORKSPACE_FOLDER%/tex/main.tex",
        "latex-workshop.latex.recipe.default": "first",
        "latex-workshop.latex.tools": [
          {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
              "-pdf",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=%OUTDIR%",
              "%DOC%"
            ]
          }
        ],
        "latex-workshop.latex.recipes": [
          {
            "name": "latexmk",
            "tools": [
              "latexmk"
            ]
          }
        ],
        "latex-workshop.latexindent.modifyLineBreaks": true,
        "latex-workshop.latexindent.args": [
          "-c",
          "%TMPFILE%/",
          "%TMPFILE%",
          "-l",
          "%WORKSPACE_FOLDER%/.latexindent.yaml"
        ],
        "latex-workshop.latex.outDir": "%DIR%/build",
        "latex-workshop.latex.autoBuild.run": "onSave",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "rust-analyzer.check.command": "check"
      }
    }
  }
}
